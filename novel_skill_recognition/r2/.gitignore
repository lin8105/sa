# Historical Round94 working artifacts remain locally beside this public
# package; whitelist only the reviewed release files below.
/*
!/README.md
!/.gitignore
!/src/
/src/*
!/src/__init__.py
!/src/r2.py
!/evaluation/
/evaluation/*
!/evaluation/__init__.py
!/evaluation/compute_metrics.py
!/evaluation/infer_held_out_test.py
!/metadata/
/metadata/*
!/metadata/config.json
!/metadata/model_provenance.csv
!/metadata/release_assets_manifest.md
!/metadata/source_mapping.md
!/metadata/round94_data_lineage.json
!/metadata/round94_model_freeze.json
!/metadata/round94_r2_training_history.csv
!/metadata/round94_split_freeze.json
!/metadata/round94_test_scales.json
!/metadata/round94_threshold_manifest.csv
!/metadata/round94_thresholds.json
!/metadata/round94_training_provenance.json
!/results/
/results/*
!/results/held_out_test_asrf_segment_r2_scores.csv
!/results/novel_skill_provenance_diagnostic.md
!/results/novel_skill_standard_metrics.csv
!/results/novel_skill_standard_metrics.md
!/figures/
/figures/*
!/figures/clean_test/
!/figures/clean_test/*.png
/figures/clean_test/round94_asrf_r2_timeline_test_plug_*.png
!/figures/clean_test/round94_asrf_r2_timeline_test_plug_p1.png
!/figures/clean_test/round94_asrf_r2_timeline_test_plug_p2.png
!/figures/clean_test/round94_asrf_r2_timeline_test_plug_p3.png
!/figures/clean_test/round94_asrf_r2_timeline_test_plug_pl_pp.png

# Never include frozen model binaries or generated runtime state in Git history.
*.pt
*.pth
*.ckpt
*.npz
__pycache__/
*.pyc
.ipynb_checkpoints/
logs/
runs/
cache/
